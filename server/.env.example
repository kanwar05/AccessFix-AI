# Express always binds to loopback. Restart it after changing environment values.
PORT=3001
CLIENT_ORIGIN=http://127.0.0.1:5173
# Only the controlled /preview route on CLIENT_ORIGIN is permitted.
PREVIEW_URL=http://127.0.0.1:5173/preview

# Local Ollama settings; the service and this exact model are needed in Phase 3.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_TIMEOUT_MS=120000
SCAN_TIMEOUT_MS=30000
